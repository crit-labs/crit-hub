# Whitelist: only the catalogue itself is tracked. Anything else in the working
# tree (evidence, builds, binaries, models, scratch) stays local by default.
/*
!/.gitignore
!/LICENSE
!/README.md
!/tools/
!/engines/

# Inside an engine folder (engines/<gpu>/<model>@<encoding>/<name>/) only these are tracked.
/engines/*/*/*/*
!/engines/*/*/*/README.md
!/engines/*/*/*/THIRD_PARTY.md
!/engines/*/*/*/LICENSES.txt
!/engines/*/*/*/engine/

# Never tracked anywhere, even inside engine/.
evidence/
build/
__pycache__/
*.pyc
*.safetensors
*.gguf
*.bin
*.log

# Vendored runtime binaries are never tracked: the repository keeps binaries
# outside it, and some of these exceed the 100 MB per-file limit GitHub enforces.
# Each engine documents the upstream assets and hashes in engine/VENDORED-RUNTIME.md.
*.dll
*.exe
