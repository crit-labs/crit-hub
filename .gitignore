# Whitelist: only the registry itself is tracked. Anything else in the working
# tree (run records, builds, binaries, models, scratch) stays local by default.
/*
!/.gitignore
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/tools/
!/schemas/
!/docs/
!/engines/
!/.github/

# Inside an engine folder (engines/<owner>/<name>/) only these are tracked; its source lives in
# the repository card.yaml pins (crit-labs/crit-engines for crit engines).
/engines/*/*/*
!/engines/*/*/README.md
!/engines/*/*/card.yaml
!/engines/*/*/card.lock.json
!/engines/*/*/evidence/

# Never tracked anywhere.
build/
__pycache__/
*.pyc
*.safetensors
*.gguf
*.bin
*.log
