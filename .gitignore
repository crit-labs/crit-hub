# Whitelist: only the registry itself is tracked. Anything else in the working
# tree (evidence, builds, binaries, models, scratch) stays local by default.
/*
!/.gitignore
!/LICENSE
!/README.md
!/tools/
!/docs/
!/engines/
!/browse/
!/.github/

# Inside an engine folder (engines/<owner>/<name>/) only these are tracked.
/engines/*/*/*
!/engines/*/*/README.md
!/engines/*/*/THIRD_PARTY.md
!/engines/*/*/LICENSES.txt
!/engines/*/*/engine.json
!/engines/*/*/engine/

# Never tracked anywhere, even inside engine/.
evidence/
build/
__pycache__/
*.pyc
*.safetensors
*.gguf
*.bin
*.log
