# Whitelist: only the registry itself is tracked. Anything else in the working
# tree (evidence, builds, binaries, models, scratch) stays local by default.
/*
!/.gitignore
!/LICENSE
!/README.md
!/tools/
!/docs/
!/engines/
!/.github/

# Inside an engine folder (engines/<owner>/<name>/) only these are tracked; its source lives in
# the repository engine.json pins (crit-labs/crit-engines for crit engines).
/engines/*/*/*
!/engines/*/*/README.md
!/engines/*/*/engine.json

# Never tracked anywhere.
evidence/
build/
__pycache__/
*.pyc
*.safetensors
*.gguf
*.bin
*.log
